# Acheron GUI launcher. Installed to ~/.local/bin/acheron-gui by install.sh
# (ticket 90). Runs the copy of the `acheron_gui` package that install.sh
# lays down at ~/.local/lib/acheron/ — it does NOT point back at a git
# checkout, so the app grid entry and this script keep working after the
# checkout is moved or deleted.
#
# Deliberately thin: no venv, no `pip install`, no Python packaging. It
# just puts the installed package dir on PYTHONPATH and hands off to the
# system python3 (which must have PyGObject / GTK 4 available — the same
# requirement as `python3 gui/main.py` from a checkout; documented for the
# user in the install docs, ticket 35).
set -euo pipefail

acheron_lib="${ACHERON_GUI_LIB:-$HOME/.local/lib/acheron}"

if [[ ! -d "$acheron_lib/acheron_gui" ]]; then
    echo "acheron-gui: GUI package not found at $acheron_lib/acheron_gui" >&2
    echo "acheron-gui: run install.sh from the Acheron source tree first." >&2
    exit 1
fi

export PYTHONPATH="$acheron_lib${PYTHONPATH:+:$PYTHONPATH}"
# Run from the installed package dir. `python3 -m` prepends the current
# directory ("") to sys.path ahead of PYTHONPATH, so launching from inside
# a git checkout's gui/ dir would otherwise import ./acheron_gui instead of
# the installed copy. cd'ing into $acheron_lib makes that implicit ""
# entry resolve to the installed package too, so nothing can shadow it.
#
# This replaces the old `python3 -P` (ticket 90), whose -P flag exists only
# on CPython 3.11+: on an older system python3 it aborts with
# "Unknown option: -P" (exit 2) and the GUI never opens — Ubuntu 22.04 LTS
# ships 3.10, Debian 11 and RHEL/Alma/Rocky 9 ship 3.9 (ticket 96).
cd "$acheron_lib"
exec python3 -m acheron_gui "$@"
