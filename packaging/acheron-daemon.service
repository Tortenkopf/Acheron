[Unit]
Description=Acheron Daemon — Tartarus Pro keybinding/macro engine
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/acheron-daemon
# A fatal exit (config.toml refused to parse, uinput/D-Bus init failed, …)
# is a permanent condition until something on disk changes — retrying just
# reproduces the same failure. Restart=on-failure previously crash-looped
# on exactly this (ticket 57: a pre-ticket-51 config.toml refused to start,
# hit systemd's start-limit within seconds, and left "Start request
# repeated too quickly" as the only visible message). No restart at all
# means one clean failure, with the real error readable via
# `systemctl --user status acheron-daemon`.
Restart=no

[Install]
WantedBy=default.target
